# Telegram bot credentials from @BotFather
BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOTFATHER_TOKEN

# Comma-separated numeric Telegram user IDs allowed to use admin commands.
# Get your own ID from @userinfobot. Never use a username here.
ADMIN_IDS=100000001

# Storage and branding
DB_PATH=shop.db
SHOP_NAME=Neo Gadgets
SHOP_CURRENCY=USD
LOW_STOCK_THRESHOLD=5

# Payment instructions: key|Label|Instructions, separated by ;;
# Use \n for a line break. Replace the placeholder addresses before going live.
PAYMENT_METHODS=usdt_trc20|USDT (TRC20)|Send USDT (TRC20) to YOUR_TRC20_ADDRESS\nThen send the transaction hash in this chat.;;btc|Bitcoin (BTC)|Send BTC to YOUR_BTC_ADDRESS\nThen send the transaction ID in this chat.;;cod|Cash on delivery|Pay in cash when your order arrives.
